{
  "name": "cloreai",
  "version": "1.0.0",
  "type": "module",
  "description": "CLORE.AI API client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladpuz/cloreai.git"
  },
  "author": "Vladislav Puzyrev",
  "license": "MIT",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "keywords": [
    "cloreai",
    "clore",
    "api"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm run format",
    "clean": "rimraf build",
    "format": "prettier --check .",
    "lint": "eslint .",
    "prepack": "npm run clean && npm run build && npm run check",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "p-queue": "^8.1.0"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^22.0.1",
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^22.13.17",
    "eslint": "^9.23.0",
    "eslint-config-vladpuz": "^1.1.0",
    "husky": "^9.1.7",
    "jiti": "^2.4.2",
    "prettier": "^3.5.3",
    "prettier-config-vladpuz": "^1.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  }
}
