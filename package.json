{
  "name": "cloreai",
  "version": "0.1.17",
  "type": "module",
  "description": "CLORE.AI API client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladpuz/cloreai.git"
  },
  "author": "Vladislav Puzyrev",
  "license": "MIT",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "keywords": [
    "cloreai",
    "clore",
    "api"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm run format",
    "clean": "rimraf build",
    "format": "prettier --check .",
    "lint": "eslint .",
    "playground": "jiti playground/index.ts",
    "prepack": "npm run clean && npm run build && npm run check",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "upgrade": "npm-check-updates --peer --upgrade && npm update"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "p-queue": "^8.1.0"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^22.0.1",
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-vladpuz": "^0.24.0",
    "husky": "^9.1.7",
    "jiti": "^2.4.2",
    "npm-check-updates": "^17.1.14",
    "prettier": "^3.4.2",
    "prettier-config-vladpuz": "^0.9.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
