{
  "name": "cloreai",
  "version": "4.1.0",
  "description": "CLORE.AI API client",
  "keywords": [
    "cloreai",
    "clore",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladpuz/cloreai.git"
  },
  "license": "MIT",
  "author": "Vladislav Puzyrev",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm run format",
    "format": "prettier --check .",
    "lint": "eslint .",
    "prepack": "npm run build && npm run check",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "p-queue": "^9.3.4"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.1",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-vladpuz": "^4.3.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-config-vladpuz": "^3.0.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
